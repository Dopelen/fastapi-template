# Скопируйте в .env и поправьте под себя: cp example.env .env
# Файл .env в репозиторий не попадает - он в .gitignore.
#
# Внутри docker compose эти значения не используются: там переменные задаются
# сервисам напрямую, с хостами "postgres" и "kafka" вместо localhost.
# Этот файл нужен для запуска с хоста: python -m app.main, тесты, отладка.

# FastAPI
APP_NAME=FastAPI Template
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
# Строка подключения собирается из этих частей в app/config.py,
# отдельной переменной POSTGRES_DSN больше нет - она дублировала их
# и жила своей жизнью.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=user
DB_PASSWORD=password

# Kafka
# Порт 29092 - внешний листенер брокера, доступный с хоста.
# Внутри docker-сети используется kafka:9092.
KAFKA_BROKER=localhost:29092
KAFKA_TOPIC=my_topic
# Группа обязательна: Kafka хранит подтверждённые смещения по ней.
# Без группы коммитить некуда, и топик читается с начала при каждом старте.
KAFKA_GROUP=default-group

# Печатать ли SQL в консоль. Для отладки: SQL_ECHO=true
SQL_ECHO=false
